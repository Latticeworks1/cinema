// A camera filming the flat pass on physical LED displays.
// Order: tear -> perspective -> depth of field (with chromatic aberration) -> palette ->
// bloom -> display geometry of the region under the pixel -> exposure, vignette, grain.
// Positions named "logical" are in the 1920x1080 space of the stage; the flat image is 2x that.

uniform shader iChannel0;
uniform float3 iResolution;
uniform float iTime;

uniform float2 uAim;
uniform float uZoom;
uniform float uFocal;
uniform float3 uRot;
uniform float2 uFocus;
uniform float uBlur;
uniform float3 uP0;
uniform float3 uP1;
uniform float3 uP2;
uniform float3 uP3;
uniform float3 uP4;
uniform float uLock;
uniform float uPunch;   // kick envelope 0..1
uniform float uTear;    // snare and kick tear 0..1
uniform float uCut;
uniform float uOut;
uniform float uBloom;
uniform float uLed;     // strength of the display geometry
uniform float uAberr;
uniform float uGrain;
uniform float uVig;
uniform float uSeed;
// Debug: 0 perspective, 1 + depth of field, 2 + palette and aberration, 3 + bloom and display, 4 all.
uniform float uStage;

// Display materials: (cell in logical px, layout 0 stripe / 1 dot / 2 delta / 3 block, dark share, angle).
// Region k is a rectangle (x0, y0, x1, y1) in logical space with its own material; the rest of the
// stage uses uScreenMat. MAX_REGIONS in lens/src/lib.rs is 6.
uniform float4 uScreenMat;
uniform float4 uRegion0;
uniform float4 uRegion1;
uniform float4 uRegion2;
uniform float4 uRegion3;
uniform float4 uRegion4;
uniform float4 uRegion5;
uniform float4 uRegion6;
uniform float4 uRegion7;
uniform float4 uMat0;
uniform float4 uMat1;
uniform float4 uMat2;
uniform float4 uMat3;
uniform float4 uMat4;
uniform float4 uMat5;
uniform float4 uMat6;
uniform float4 uMat7;

const float FLAT_SCALE = 2.0;
const float LW = 1920.0;
const float LH = 1080.0;
const int TAPS = 36;
const int GLOW_TAPS = 16;
// Blur radius, in display cells, below which one tap is enough and above which all are used.
const float ONE_TAP_CELLS = 0.5;
const float FEW_TAPS_CELLS = 3.0;
const int FEW_TAPS = 12;
// Gain before the exposure kick: the flat pass is mostly black, so the mean frame is dark.
const float EXPOSURE = 1.6;

float hash(float2 p) {
    return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

float3 pal(float x) {
    float t = clamp(x, 0.0, 1.0) * 4.0;
    if (t < 1.0) { return mix(uP0, uP1, t); }
    if (t < 2.0) { return mix(uP1, uP2, t - 1.0); }
    if (t < 3.0) { return mix(uP2, uP3, t - 2.0); }
    return mix(uP3, uP4, t - 3.0);
}

// Flat pass at a logical position; black outside the screen.
float3 screenAt(float2 q) {
    float inside = step(0.0, q.x) * step(0.0, q.y) * step(q.x, LW) * step(q.y, LH);
    return iChannel0.eval(q * FLAT_SCALE).rgb * inside;
}

float4 pick(float4 region, float4 m, float2 q, float4 cur) {
    float inside = step(region.x, q.x) * step(region.y, q.y) * step(q.x, region.z) * step(q.y, region.w);
    return mix(cur, m, inside);
}

float4 materialAt(float2 q) {
    float4 m = uScreenMat;
    m = pick(uRegion0, uMat0, q, m);
    m = pick(uRegion1, uMat1, q, m);
    m = pick(uRegion2, uMat2, q, m);
    m = pick(uRegion3, uMat3, q, m);
    m = pick(uRegion4, uMat4, q, m);
    m = pick(uRegion5, uMat5, q, m);
    m = pick(uRegion6, uMat6, q, m);
    m = pick(uRegion7, uMat7, q, m);
    return m;
}

float dotMask(float2 d, float r) {
    return 1.0 - smoothstep(r - 0.1, r, length(d));
}

// Light the display lets through at a logical position, per colour channel.
float3 displayMask(float2 q, float4 m) {
    float2 p = q / m.x;
    float ca = cos(m.w);
    float sa = sin(m.w);
    p = float2(ca * p.x - sa * p.y, sa * p.x + ca * p.y);
    int kind = int(m.y + 0.5);
    float gap = m.z;
    float2 cu = fract(p) - 0.5;
    if (kind == 0) {
        // Equal-area RGB stripes per cell inside rounded rows.
        float u = cu.x + 0.5;
        float3 sub = 0.5 + 0.5 * cos(6.2831853 * (float3(u) - float3(0.1667, 0.5, 0.8333)));
        float rowm = 1.0 - smoothstep(0.5 - gap * 0.8, 0.5, abs(cu.y));
        float colm = 1.0 - smoothstep(0.36, 0.5, abs(cu.x));
        return rowm * colm * (0.4 + 1.0 * sub);
    }
    if (kind == 1) {
        // Round dots.
        float r = 0.5 - gap * 0.5;
        return float3(1.5 * dotMask(cu, r));
    }
    if (kind == 2) {
        // Delta: rows offset by half a cell, a triad of dots per cell.
        float row = floor(p.y);
        float2 d = float2(fract(p.x + 0.5 * mod(row, 2.0)) - 0.5, fract(p.y) - 0.5);
        float r = 0.24 - gap * 0.1;
        float3 led = float3(dotMask(d - float2(-0.22, 0.17), r),
                            dotMask(d - float2(0.22, 0.17), r),
                            dotMask(d - float2(0.0, -0.2), r));
        return 0.5 + 1.7 * led;
    }
    // Hard square cells with a dark gap.
    float e = 0.5 - gap * 0.5;
    float mx = 1.0 - smoothstep(e - 0.05, e, abs(cu.x));
    float my = 1.0 - smoothstep(e - 0.05, e, abs(cu.y));
    return float3(1.2 * mx * my);
}

float3x3 rotation() {
    float cx = cos(uRot.x); float sx = sin(uRot.x);
    float cy = cos(uRot.y); float sy = sin(uRot.y);
    float cz = cos(uRot.z); float sz = sin(uRot.z);
    float3x3 rx = float3x3(1.0, 0.0, 0.0,  0.0, cx, sx,  0.0, -sx, cx);
    float3x3 ry = float3x3(cy, 0.0, -sy,  0.0, 1.0, 0.0,  sy, 0.0, cy);
    float3x3 rz = float3x3(cz, sz, 0.0,  -sz, cz, 0.0,  0.0, 0.0, 1.0);
    return rz * ry * rx;
}

half4 main(float2 coord) {
    float2 res = iResolution.xy;
    float2 frameSeed = float2(uSeed, floor(iTime * 30.0));

    // Tear: on a lock, a cut and a hit, a few rows slide sideways.
    float2 px = coord;
    float shake = uLock + uCut + uTear;
    if (shake > 0.0 && uStage >= 4.0) {
        float band = floor(coord.y / 16.0);
        float n = hash(float2(band, frameSeed.x * 3.7 + frameSeed.y));
        float hit = step(0.93 - 0.18 * shake, n);
        px.x += hit * (hash(float2(band, frameSeed.y + 9.0)) - 0.5) * 220.0 * shake;
    }

    // Perspective: a ray per pixel hits the tilted screen plane.
    float2 s = (px - 0.5 * res) / res.y;
    float3 d = float3(s.x, s.y, uFocal);
    float3x3 R = rotation();
    float3 eu = R * float3(1.0, 0.0, 0.0);
    float3 ev = R * float3(0.0, 1.0, 0.0);
    float3 n = R * float3(0.0, 0.0, 1.0);
    float3 p0 = float3(0.0, 0.0, 1.0);
    float dn = dot(d, n);
    if (dn <= 0.0001) { return half4(half3(pal(0.0) * (1.0 - uOut)), 1.0); }
    float3 hit3 = d * (dot(p0, n) / dn);
    float2 local = float2(dot(hit3 - p0, eu), dot(hit3 - p0, ev));
    float K = uFocal * LH / uZoom;
    float2 base = uAim + local * K;
    float z = hit3.z;

    // The display under this pixel sets the cell size every tap quantises to.
    float4 mat = materialAt(base);
    float cell = mat.x;

    // Depth of field: circle of confusion from the depth difference to the tracked note.
    float2 fl = (uFocus - uAim) / K;
    float zf = (p0 + eu * fl.x + ev * fl.y).z;
    float coc = clamp(uBlur * 190.0 * abs(1.0 - zf / z), 0.0, 46.0);
    float logPerPx = LH / (uZoom * res.y) * z;
    float rLog = coc * logPerPx * step(1.0, uStage);
    int nTaps = TAPS;
    if (rLog < ONE_TAP_CELLS * cell) { nTaps = 1; }
    else if (rLog < FEW_TAPS_CELLS * cell) { nTaps = FEW_TAPS; }

    // Chromatic aberration grows toward the edges and on a lock.
    float2 ca = step(2.0, uStage) * s * (0.012 * uAberr + 0.016 * uLock + 0.008 * uCut) * (LH / uZoom);

    float spin = hash(coord * 0.37 + frameSeed) * 6.2831;
    float3 accG = float3(0.0);
    float accR = 0.0;
    float accB = 0.0;
    float wsum = 0.0;
    for (int i = 0; i < TAPS; i++) {
        if (i >= nTaps) { break; }
        float fi = float(i);
        float a = fi * 2.39996323 + spin;
        float r = sqrt((fi + 0.5) / float(nTaps)) * rLog;
        float2 q = base + float2(cos(a), sin(a)) * r;
        // LED pixels: every tap reads the centre of its cell.
        float2 qs = (floor(q / cell) + 0.5) * cell;
        float3 g = screenAt(qs);
        float w = 1.0 + 7.0 * g.g * g.g * g.g;
        accG += g * w;
        accR += screenAt(qs + ca).g * w;
        accB += screenAt(qs - ca).g * w;
        wsum += w;
    }
    accG /= wsum;
    accR /= wsum;
    accB /= wsum;

    // Red marks a locked note in the flat pass; it stays red in every palette.
    float red = clamp((accG.r - accG.g) * 1.4, 0.0, 1.0);
    float3 col = float3(pal(accR).r, pal(accG.g).g, pal(accB).b);
    if (uStage < 2.0) { col = accG; }
    col = mix(col, float3(1.0, 0.13, 0.10), red);

    // Bloom: a wide ring of taps lifts everything around bright glyphs.
    float glowOn = step(3.0, uStage);
    if (uBloom > 0.01) {
        float glowR = 26.0 * logPerPx + rLog * 0.6;
        float glow = 0.0;
        float glowRed = 0.0;
        for (int j = 0; j < GLOW_TAPS; j++) {
            float fj = float(j);
            float a = fj * 2.39996323 + spin * 0.5;
            float r = sqrt((fj + 0.5) / float(GLOW_TAPS)) * glowR;
            float3 g = screenAt(base + float2(cos(a), sin(a)) * r);
            glow += g.g;
            glowRed += clamp(g.r - g.g, 0.0, 1.0);
        }
        glow /= float(GLOW_TAPS);
        glowRed /= float(GLOW_TAPS);
        col += pal(min(1.0, glow * 1.6)) * glow * uBloom * 1.5 * (1.0 + 0.6 * uPunch) * glowOn;
        col += float3(1.0, 0.1, 0.05) * glowRed * 0.9 * glowOn;
    }

    // Display geometry of the region under the pixel; it fades out of focus and where cells get too small.
    float cellPx = cell / logPerPx;
    float ledAmt = (1.0 - smoothstep(0.8, 3.5, rLog / cell)) * smoothstep(2.2, 4.5, cellPx);
    float3 led = displayMask(base, mat);
    col *= mix(float3(1.0), led * 1.3, ledAmt * uLed * glowOn);

    // Exposure kick on a cut, vignette, rolling flicker, grain, final fade.
    float post = step(4.0, uStage);
    col = col * (EXPOSURE + (uCut * 1.1 + uPunch * 0.18) * post) + uCut * 0.06 * post;
    float2 v = s * float2(0.85, 1.15);
    col *= 1.0 - 0.84 * uVig * dot(v, v) * post;
    col *= 1.0 - post * (0.035 - 0.035 * sin(coord.y * 0.9 - iTime * 55.0));
    col += (hash(coord + frameSeed * 1.31) - 0.5) * 0.12 * uGrain * post;
    col *= 1.0 - uOut;
    return half4(half3(clamp(col, 0.0, 1.0)), 1.0);
}
